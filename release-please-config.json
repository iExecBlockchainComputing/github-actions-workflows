{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "always-update": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "release-type": "simple",
  "separate-pull-requests": true,
  "tag-separator": "-",
  "packages": {
    "conventional-commits": {
      "component": "conventional-commits",
      "extra-label": "conventional-commits"
    },
    "docker-build": {
      "component": "docker-build",
      "extra-label": "docker-build"
    },
    "docker-build-cloud": {
      "component": "docker-build-cloud",
      "extra-label": "docker-build-cloud"
    },
    "docker-promote": {
      "component": "docker-promote",
      "extra-label": "docker-promote"
    },
    "java-build": {
      "component": "java-build",
      "extra-label": "java-build"
    },
    "propose-safe-multisig-tx": {
      "component": "propose-safe-multisig-tx",
      "extra-label": "propose-safe-multisig-tx"
    },
    "publish-npm": {
      "component": "publish-npm",
      "extra-label": "publish-npm"
    },
    "release-please": {
      "component": "release-please",
      "extra-label": "release-please"
    },
    "rust-build": {
      "component": "rust-build",
      "extra-label": "rust-build"
    },
    "stale": {
      "component": "stale",
      "extra-label": "stale"
    }
  }
}
